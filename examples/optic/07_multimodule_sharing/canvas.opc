// Example 07 (Module 1/3) — `canvas`: library exporting an encapsulated `Canvas` object + methods

const DEFAULT_BG: u8 = b'.';
static mut CREATED_COUNT: i32 = 0;

export struct Canvas {
    width: i32,   // bytes[0..4) (private to `canvas`)
    height: i32,  // bytes[4..8) (private to `canvas`)
    pixels: []u8, // refs[0]     (private to `canvas`)
}

export impl Canvas {
    fn new(width: i32, height: i32) -> Canvas {
        CREATED_COUNT += 1;
        let total = width * height;
        let pixels = new [u8; total];
        for i in 0..total {
            pixels[i] = DEFAULT_BG;
        }
        return Canvas {
            width: width,
            height: height,
            pixels: pixels,
        };
    }

    fn set_pixel(self, x: i32, y: i32, ch: u8) {
        if x >= 0 && x < self.width && y >= 0 && y < self.height {
            self.pixels[y * self.width + x] = ch;
        }
    }

    fn fill_rect(self, x: i32, y: i32, w: i32, h: i32, ch: u8) {
        for dy in 0..h {
            for dx in 0..w {
                self.set_pixel(x + dx, y + dy, ch);
            }
        }
    }

    fn width(self: ro Self) -> i32 {
        return self.width;
    }

    fn height(self: ro Self) -> i32 {
        return self.height;
    }

    fn get_pixel(self: ro Self, x: i32, y: i32) -> u8 {
        if x >= 0 && x < self.width && y >= 0 && y < self.height {
            return self.pixels[y * self.width + x];
        }
        return 0;
    }

    fn row(self: ro Self, y: i32) -> ro []u8 {
        let start = y * self.width;
        return readonly(self.pixels[start..start + self.width]);
    }
}

export fn get_created_count() -> i32 {
    return CREATED_COUNT;
}
