;; Guessed WAT for examples/optic/07_multimodule_sharing/main.opc
(module
  (import "host"     "trace_i32"         (func $trace_i32         (param ro_handle i32)))
  (import "host"     "trace_meta"        (func $trace_meta        (param ro_handle ro_handle)))
  (import "host"     "io_open_reader"    (func $io_open_reader    (param ro_handle) (result ro_handle)))
  (import "host"     "io_read"           (func $io_read           (param ro_handle rw_handle) (result i32)))
  (import "host"     "io_write"          (func $io_write          (param ro_handle ro_handle) (result i32)))
  (import "canvas"   "Canvas__new"       (func $Canvas__new       (param i32 i32) (result rw_handle)))
  (import "canvas"   "Canvas__set_pixel" (func $Canvas__set_pixel (param rw_handle i32 i32 i32)))
  (import "canvas"   "Canvas__fill_rect" (func $Canvas__fill_rect (param rw_handle i32 i32 i32 i32 i32)))
  (import "canvas"   "Canvas__width"     (func $Canvas__width     (param ro_handle) (result i32)))
  (import "canvas"   "Canvas__height"    (func $Canvas__height    (param ro_handle) (result i32)))
  (import "canvas"   "Canvas__get_pixel" (func $Canvas__get_pixel (param ro_handle i32 i32) (result i32)))
  (import "canvas"   "get_created_count" (func $get_created_count (result i32)))
  (import "renderer" "count_ink"         (func $count_ink         (param ro_handle i32) (result i32)))
  (import "renderer" "render_row"        (func $render_row        (param ro_handle ro_handle i32) (result i32)))
  (import "renderer" "get_inspect_count" (func $get_inspect_count (result i32)))

  (string $l1  "step1.ink_before_mut")
  (string $l2  "step2.row0_before")
  (string $l3  "step3.ink_after_mut")
  (string $l4  "step4.row0_after")
  (string $l5  "step5.row2_after")
  (string $l6  "step6.pixel_4_0")
  (string $l7  "step7.c2_area")
  (string $l8  "step8.canvases_created")
  (string $l9  "step9.renderer_inspects")
  (string $l10 "step10.reader_meta")
  (string $l11 "step11.io_chunk1")
  (string $s_stream "Optic-IO-Stream")

  (func (export "main") (result i32)
    (local $c rw_handle)
    (local $ro_c ro_handle)
    (local $ink1 i32)
    (local $r0 i32)
    (local $ink2 i32)
    (local $r1 i32)
    (local $r2 i32)
    (local $c2 rw_handle)
    (local $ro_c2 ro_handle)
    (local $reader ro_handle)
    (local $chunk rw_handle)
    (local $n1 i32)
    (local $w1 i32)

    ;; 1. Create Canvas and draw 2x2 '#' box at (1, 0)
    (local.set $c (call $Canvas__new (i32.const 6) (i32.const 3)))
    (call $Canvas__fill_rect (local.get $c) (i32.const 1) (i32.const 0) (i32.const 2) (i32.const 2) (i32.const 35))

    ;; Downgrade to ro Canvas (zero-alloc static rw_handle <: ro_handle) and share with renderer
    (local.set $ro_c (local.get $c))
    (local.set $ink1 (call $count_ink (local.get $ro_c) (i32.const 35)))
    (call $trace_i32 (mem.const_str $l1) (local.get $ink1))
    (local.set $r0 (call $render_row (mem.const_str $l2) (local.get $ro_c) (i32.const 0)))

    ;; 2. Mutate original rw handle; renderer sees updates via same ro_c handle
    (call $Canvas__set_pixel (local.get $c) (i32.const 4) (i32.const 0) (i32.const 35))
    (call $Canvas__fill_rect (local.get $c) (i32.const 0) (i32.const 2) (i32.const 6) (i32.const 1) (i32.const 35))
    (local.set $ink2 (call $count_ink (local.get $ro_c) (i32.const 35)))
    (call $trace_i32 (mem.const_str $l3) (local.get $ink2))
    (local.set $r1 (call $render_row (mem.const_str $l4) (local.get $ro_c) (i32.const 0)))
    (local.set $r2 (call $render_row (mem.const_str $l5) (local.get $ro_c) (i32.const 2)))

    (call $trace_i32 (mem.const_str $l6)
      (call $Canvas__get_pixel (local.get $ro_c) (i32.const 4) (i32.const 0)))

    ;; 3. Second Canvas verifies module global counters
    (local.set $c2 (call $Canvas__new (i32.const 4) (i32.const 2)))
    (local.set $ro_c2 (local.get $c2))
    (call $trace_i32 (mem.const_str $l7)
      (i32.mul (call $Canvas__width (local.get $ro_c2)) (call $Canvas__height (local.get $ro_c2))))
    (call $trace_i32 (mem.const_str $l8) (call $get_created_count))
    (call $trace_i32 (mem.const_str $l9) (call $get_inspect_count))

    ;; 4. Capability-safe host I/O
    (local.set $reader (call $io_open_reader (mem.const_str $s_stream)))
    (call $trace_meta (mem.const_str $l10) (local.get $reader))
    (local.set $chunk (mem.alloc (i32.const 6) (i32.const 0)))
    (local.set $n1 (call $io_read (local.get $reader) (local.get $chunk)))
    (local.set $w1 (call $io_write (mem.const_str $l11)
                     (mem.span (local.get $chunk) (i32.const 0) (local.get $n1))))

    (i32.add
      (i32.add (local.get $ink1) (local.get $ink2))
      (i32.add (i32.add (local.get $r0) (local.get $r1))
               (i32.add (local.get $r2) (local.get $w1)))))
)
