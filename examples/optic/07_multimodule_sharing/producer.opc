// Example 07 (Module 2/3) — `producer`: allocates `[]u8` packets using a module global counter

const HEADER_TAG: u8 = 10;
static mut NEXT_SEQ: i32 = 100;

export fn make_packet(payload_val: u8) -> []u8 {
    let seq = NEXT_SEQ;
    NEXT_SEQ += 1;
    let buf = new [u8; 3];
    buf[0] = HEADER_TAG;
    buf[1] = (seq & 0xff) as u8;
    buf[2] = payload_val;
    return buf;
}
