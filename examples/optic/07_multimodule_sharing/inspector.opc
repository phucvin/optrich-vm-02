// Example 07 (Module 1/3) — `inspector`: reads zero-copy `ro []u8` and tracks module global state

static mut CALL_COUNT: i32 = 0;

export fn inspect_checksum(data: ro []u8) -> i32 {
    CALL_COUNT += 1;
    let mut sum = 0;
    for i in 0..data.len {
        sum += data[i] as i32;
    }
    return sum;
}

export fn get_call_count() -> i32 {
    return CALL_COUNT;
}
