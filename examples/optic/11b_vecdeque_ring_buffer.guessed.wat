;; Guessed WAT for examples/optic/11b_vecdeque_ring_buffer.opc
;; VecDeque<i32>: mem.alloc(12, 1) -> bytes[0..4)=head, bytes[4..8)=len, bytes[8..12)=cap, refs[0]=buf([]i32)
(module
  (import "host" "trace_i32" (func $trace_i32 (param ro_handle i32)))

  (string $l1 "step1.pop_front")
  (string $l2 "step2.wrapped_len")
  (string $l3 "step3.grown_cap")
  (string $l4 "step4.grown_len")
  (string $l5 "step5.pop_back")
  (string $l6 "step6.pop_front_2")
  (string $l7 "step7.pop_front_3")

  (func $VecDeque_i32__new (param $cap i32) (result rw_handle)
    (local $d rw_handle)
    (local.set $d (mem.alloc (i32.const 12) (i32.const 1)))
    (mem.write_i32 (local.get $d) (i32.const 0) (i32.const 0))
    (mem.write_i32 (local.get $d) (i32.const 4) (i32.const 0))
    (mem.write_i32 (local.get $d) (i32.const 8) (local.get $cap))
    (mem.write_ref (local.get $d) (i32.const 0) (mem.alloc (i32.shl (local.get $cap) (i32.const 2)) (i32.const 0)))
    (local.get $d))

  (func $VecDeque_i32__grow (param $d rw_handle)
    (local $head i32)
    (local $len i32)
    (local $cap i32)
    (local $new_cap i32)
    (local $old_buf handle)
    (local $new_buf rw_handle)
    (local $first_part i32)
    (local $second_part i32)

    (local.set $head (mem.read_i32 (local.get $d) (i32.const 0)))
    (local.set $len  (mem.read_i32 (local.get $d) (i32.const 4)))
    (local.set $cap  (mem.read_i32 (local.get $d) (i32.const 8)))
    (local.set $new_cap (i32.shl (local.get $cap) (i32.const 1)))
    (local.set $old_buf (mem.read_ref (local.get $d) (i32.const 0)))
    (local.set $new_buf (mem.alloc (i32.shl (local.get $new_cap) (i32.const 2)) (i32.const 0)))

    ;; Linearize wrapped ring buffer via up to 2 bulk mem.copy calls
    (local.set $first_part (i32.sub (local.get $cap) (local.get $head)))
    (if (i32.gt_s (local.get $first_part) (local.get $len))
      (then (local.set $first_part (local.get $len))))
    (mem.copy (local.get $new_buf) (i32.const 0)
              (local.get $old_buf) (i32.shl (local.get $head) (i32.const 2))
              (i32.shl (local.get $first_part) (i32.const 2)))
    (local.set $second_part (i32.sub (local.get $len) (local.get $first_part)))
    (if (i32.gt_s (local.get $second_part) (i32.const 0))
      (then
        (mem.copy (local.get $new_buf) (i32.shl (local.get $first_part) (i32.const 2))
                  (local.get $old_buf) (i32.const 0)
                  (i32.shl (local.get $second_part) (i32.const 2)))))

    (mem.write_i32 (local.get $d) (i32.const 0) (i32.const 0))
    (mem.write_i32 (local.get $d) (i32.const 8) (local.get $new_cap))
    (mem.write_ref (local.get $d) (i32.const 0) (local.get $new_buf)))

  (func $VecDeque_i32__push_back (param $d rw_handle) (param $val i32)
    (local $head i32)
    (local $len i32)
    (local $cap i32)
    (local $idx i32)
    (local.set $len (mem.read_i32 (local.get $d) (i32.const 4)))
    (local.set $cap (mem.read_i32 (local.get $d) (i32.const 8)))
    (if (i32.eq (local.get $len) (local.get $cap))
      (then
        (call $VecDeque_i32__grow (local.get $d))
        (local.set $cap (mem.read_i32 (local.get $d) (i32.const 8)))))
    (local.set $head (mem.read_i32 (local.get $d) (i32.const 0)))
    (local.set $idx (i32.and (i32.add (local.get $head) (local.get $len)) (i32.sub (local.get $cap) (i32.const 1))))
    (mem.write_i32 (mem.read_ref (local.get $d) (i32.const 0)) (i32.shl (local.get $idx) (i32.const 2)) (local.get $val))
    (mem.write_i32 (local.get $d) (i32.const 4) (i32.add (local.get $len) (i32.const 1))))

  (func $VecDeque_i32__push_front (param $d rw_handle) (param $val i32)
    (local $head i32)
    (local $len i32)
    (local $cap i32)
    (local.set $len (mem.read_i32 (local.get $d) (i32.const 4)))
    (local.set $cap (mem.read_i32 (local.get $d) (i32.const 8)))
    (if (i32.eq (local.get $len) (local.get $cap))
      (then
        (call $VecDeque_i32__grow (local.get $d))
        (local.set $cap (mem.read_i32 (local.get $d) (i32.const 8)))))
    (local.set $head (i32.and (i32.sub (mem.read_i32 (local.get $d) (i32.const 0)) (i32.const 1))
                              (i32.sub (local.get $cap) (i32.const 1))))
    (mem.write_i32 (local.get $d) (i32.const 0) (local.get $head))
    (mem.write_i32 (mem.read_ref (local.get $d) (i32.const 0)) (i32.shl (local.get $head) (i32.const 2)) (local.get $val))
    (mem.write_i32 (local.get $d) (i32.const 4) (i32.add (local.get $len) (i32.const 1))))

  (func $VecDeque_i32__pop_front (param $d rw_handle) (result i32)
    (local $head i32)
    (local $len i32)
    (local $cap i32)
    (local $val i32)
    (local.set $len (mem.read_i32 (local.get $d) (i32.const 4)))
    (if (i32.le_s (local.get $len) (i32.const 0)) (then (unreachable)))
    (local.set $head (mem.read_i32 (local.get $d) (i32.const 0)))
    (local.set $cap  (mem.read_i32 (local.get $d) (i32.const 8)))
    (local.set $val (mem.read_i32 (mem.read_ref (local.get $d) (i32.const 0)) (i32.shl (local.get $head) (i32.const 2))))
    (mem.write_i32 (local.get $d) (i32.const 0)
      (i32.and (i32.add (local.get $head) (i32.const 1)) (i32.sub (local.get $cap) (i32.const 1))))
    (mem.write_i32 (local.get $d) (i32.const 4) (i32.sub (local.get $len) (i32.const 1)))
    (local.get $val))

  (func $VecDeque_i32__pop_back (param $d rw_handle) (result i32)
    (local $head i32)
    (local $len i32)
    (local $cap i32)
    (local $idx i32)
    (local.set $len (mem.read_i32 (local.get $d) (i32.const 4)))
    (if (i32.le_s (local.get $len) (i32.const 0)) (then (unreachable)))
    (local.set $len (i32.sub (local.get $len) (i32.const 1)))
    (local.set $head (mem.read_i32 (local.get $d) (i32.const 0)))
    (local.set $cap  (mem.read_i32 (local.get $d) (i32.const 8)))
    (local.set $idx (i32.and (i32.add (local.get $head) (local.get $len)) (i32.sub (local.get $cap) (i32.const 1))))
    (mem.write_i32 (local.get $d) (i32.const 4) (local.get $len))
    (mem.read_i32 (mem.read_ref (local.get $d) (i32.const 0)) (i32.shl (local.get $idx) (i32.const 2))))

  (func (export "main") (result i32)
    (local $dq rw_handle)
    (local $f1 i32)
    (local $b1 i32)
    (local $f2 i32)
    (local $f3 i32)

    (local.set $dq (call $VecDeque_i32__new (i32.const 4)))
    (call $VecDeque_i32__push_back (local.get $dq) (i32.const 10))
    (call $VecDeque_i32__push_back (local.get $dq) (i32.const 20))
    (call $VecDeque_i32__push_back (local.get $dq) (i32.const 30))

    (local.set $f1 (call $VecDeque_i32__pop_front (local.get $dq)))
    (call $trace_i32 (mem.const_str $l1) (local.get $f1))

    (call $VecDeque_i32__push_back (local.get $dq) (i32.const 40))
    (call $VecDeque_i32__push_back (local.get $dq) (i32.const 50))
    (call $trace_i32 (mem.const_str $l2) (mem.read_i32 (local.get $dq) (i32.const 4)))

    (call $VecDeque_i32__push_front (local.get $dq) (i32.const 5))
    (call $trace_i32 (mem.const_str $l3) (mem.read_i32 (local.get $dq) (i32.const 8)))
    (call $trace_i32 (mem.const_str $l4) (mem.read_i32 (local.get $dq) (i32.const 4)))

    (local.set $b1 (call $VecDeque_i32__pop_back (local.get $dq)))
    (local.set $f2 (call $VecDeque_i32__pop_front (local.get $dq)))
    (local.set $f3 (call $VecDeque_i32__pop_front (local.get $dq)))
    (call $trace_i32 (mem.const_str $l5) (local.get $b1))
    (call $trace_i32 (mem.const_str $l6) (local.get $f2))
    (call $trace_i32 (mem.const_str $l7) (local.get $f3))

    (i32.add (i32.add (local.get $f1) (local.get $b1))
             (i32.add (local.get $f2) (local.get $f3))))
)
