// Example 09 — Non-Capturing `fn` Values, Capturing Closures, and Heap-Promoted `let mut` Cells

import host::trace_i32;
import host::trace_meta;

// 1. Non-capturing `fn(i32) -> i32` values (zero-allocation funcref + call_ref)
fn double_it(x: i32) -> i32 { return x * 2; }
fn square_it(x: i32) -> i32 { return x * x; }

fn apply_fn(f: fn(i32) -> i32, x: i32) -> i32 {
    return f(x);
}

// 2. Capturing closure returning Closure<i32 -> i32> (env split block)
fn make_adder(k: i32) -> |i32| -> i32 {
    return |x: i32| -> i32 { return k + x; };
}

export fn main() -> i32 {
    let a = apply_fn(double_it, 7);  // 14
    let b = apply_fn(square_it, 6);  // 36
    trace_i32("step1.fn_double", a);
    trace_i32("step2.fn_square", b);

    let add10 = make_adder(10);
    trace_meta("step3.closure_env_meta", add10);
    let c = add10(5); // 15
    trace_i32("step4.add10_5", c);

    // 3. Heap-promoted `let mut` capture cell shared across closures + outer scope
    let mut total = 100;
    let inc = |delta: i32| -> i32 {
        total += delta;
        return total;
    };
    let read = || -> i32 {
        return total;
    };

    let t1 = inc(15); // 115
    let t2 = inc(25); // 140
    total += 5;       // outer scope mutates the same promoted cell -> 145
    let t3 = read();  // 145

    trace_i32("step5.mut_capture_1", t1);
    trace_i32("step6.mut_capture_2", t2);
    trace_i32("step7.mut_capture_read", t3);

    return a + b + c + t3;
}
