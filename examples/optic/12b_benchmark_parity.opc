// Example 12b — Benchmark Parity: Sieve of Eratosthenes & Tight Array Sum (Phase 5 Superinstructions)

import host::trace_i32;

fn sieve_count(limit: i32) -> i32 {
    let flags = new [u8; limit + 1];
    for i in 2..limit + 1 {
        flags[i] = 1;
    }
    let mut p = 2;
    while p * p <= limit {
        if flags[p] != 0 {
            let mut m = p * p;
            while m <= limit {
                flags[m] = 0;
                m += p;
            }
        }
        p += 1;
    }
    let mut count = 0;
    for i in 2..limit + 1 {
        count += flags[i] as i32;
    }
    return count;
}

fn array_sum(n: i32) -> i32 {
    let arr = new [i32; n];
    for i in 0..n {
        arr[i] = i;
    }
    let mut sum = 0;
    for i in 0..n {
        sum += arr[i];
    }
    return sum;
}

export fn main() -> i32 {
    let primes_1000 = sieve_count(1000); // 168 primes <= 1000
    let sum_1000 = array_sum(1000);      // 0 + 1 + ... + 999 = 499500
    trace_i32("step1.primes_le_1000", primes_1000);
    trace_i32("step2.array_sum_1000", sum_1000);
    return primes_1000 + sum_1000;
}
