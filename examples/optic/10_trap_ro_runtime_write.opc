// Runtime Trap Spec 10h — Attempting `mem.read_ref_rw` on a read-only handle stored in a ref slot traps at runtime

import host::trace_meta;

export fn main() -> i32 {
    let s: str = "frozen";
    trace_meta("step1.frozen_meta", s);
    // Even if a read-only handle is stored in a ref slot, reading it back as `rw_handle` traps at runtime!
    unsafe_write_byte(s, 0, b'X');
    return 0;
}
