// Runtime Trap Spec 10h — Dynamic handle holding a read-only block traps on write (defense-in-depth)

import host::trace_meta;

export fn main() -> i32 {
    let s: str = "frozen";
    trace_meta("step1.frozen_meta", s);
    // Even if a dynamic `handle` bypasses static `ro_handle` checks, VM traps at runtime!
    unsafe_write_byte(s, 0, b'X');
    return 0;
}
