// Example 12 (Module 1/3) — `lexer`: zero-copy tokenizer over `str` (`ro []u8`)
// Token kinds: 0=IDENT, 1=NUM, 2=EQ, 3=SEMI

struct Token {
    kind: i32, // bytes[0..4)
    text: str, // refs[0] (zero-copy mem.span into input!)
}

fn is_alpha(b: u8) -> bool {
    return (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || b == b'_';
}

fn is_digit(b: u8) -> bool {
    return b >= b'0' && b <= b'9';
}

export fn tokenize(src: str) -> Vec<Token> {
    let toks = Vec<Token>::new(8);
    let mut i = 0;
    let n = src.len;
    while i < n {
        let b = src[i];
        if b == b' ' || b == b'\t' || b == b'\n' {
            i += 1;
        } else if b == b'=' {
            toks.push(Token { kind: 2, text: src[i..i + 1] });
            i += 1;
        } else if b == b';' {
            toks.push(Token { kind: 3, text: src[i..i + 1] });
            i += 1;
        } else if is_alpha(b) {
            let start = i;
            while i < n && (is_alpha(src[i]) || is_digit(src[i])) {
                i += 1;
            }
            toks.push(Token { kind: 0, text: src[start..i] });
        } else if is_digit(b) {
            let start = i;
            while i < n && is_digit(src[i]) {
                i += 1;
            }
            toks.push(Token { kind: 1, text: src[start..i] });
        } else {
            i += 1;
        }
    }
    return toks;
}
