;; Guessed WAT for examples/optic/12_capstone_kv_parser/parser.opc
;; KvEntry     : mem.alloc(4, 1) -> bytes[0..4)=value, refs[0]=key (ro_handle)
;; Vec<KvEntry>: mem.alloc(8, 1) -> bytes[0..4)=len, bytes[4..8)=cap, refs[0]=mem.alloc(0, cap)
(module
  (func $parse_u32 (param $s ro_handle) (result i32)
    (local $acc i32)
    (local $i i32)
    (local $end i32)
    (local.set $end (mem.byte_len (local.get $s)))
    (block $break
      (loop $cont
        (br_if $break (i32.ge_s (local.get $i) (local.get $end)))
        (local.set $acc
          (i32.add (i32.mul (local.get $acc) (i32.const 10))
                   (i32.sub (mem.read_u8 (local.get $s) (local.get $i)) (i32.const 48))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $cont)))
    (local.get $acc))

  (func $Vec_Kv__new (param $cap i32) (result rw_handle)
    (local $v rw_handle)
    (local.set $v (mem.alloc (i32.const 8) (i32.const 1)))
    (mem.write_i32 (local.get $v) (i32.const 0) (i32.const 0))
    (mem.write_i32 (local.get $v) (i32.const 4) (local.get $cap))
    (mem.write_ref (local.get $v) (i32.const 0) (mem.alloc (i32.const 0) (local.get $cap)))
    (local.get $v))

  (func $Vec_Kv__push (param $v rw_handle) (param $e rw_handle)
    (local $len i32)
    (local $cap i32)
    (local $buf rw_handle)
    (local $new_cap i32)
    (local $new_buf rw_handle)
    (local.set $len (mem.read_i32 (local.get $v) (i32.const 0)))
    (local.set $cap (mem.read_i32 (local.get $v) (i32.const 4)))
    (local.set $buf (mem.read_ref_rw (local.get $v) (i32.const 0)))
    (if (i32.ge_s (local.get $len) (local.get $cap))
      (then
        (local.set $new_cap (i32.shl (local.get $cap) (i32.const 1)))
        (local.set $new_buf (mem.alloc (i32.const 0) (local.get $new_cap)))
        (mem.copy_refs (local.get $new_buf) (i32.const 0) (local.get $buf) (i32.const 0) (local.get $len))
        (mem.write_i32 (local.get $v) (i32.const 4) (local.get $new_cap))
        (mem.write_ref (local.get $v) (i32.const 0) (local.get $new_buf))
        (local.set $buf (local.get $new_buf))))
    (mem.write_ref (local.get $buf) (local.get $len) (local.get $e))
    (mem.write_i32 (local.get $v) (i32.const 0) (i32.add (local.get $len) (i32.const 1))))

  (func (export "parse_kv") (param $toks ro_handle) (result rw_handle)
    (local $entries rw_handle)
    (local $tbuf ro_handle)
    (local $i i32)
    (local $n i32)
    (local $ktok ro_handle)
    (local $vtok ro_handle)
    (local $e rw_handle)

    (local.set $entries (call $Vec_Kv__new (i32.const 4)))
    (local.set $n (mem.read_i32 (local.get $toks) (i32.const 0)))
    (local.set $tbuf (mem.read_ref_ro (local.get $toks) (i32.const 0)))
    (block $done
      (loop $lp
        (br_if $done (i32.ge_s (i32.add (local.get $i) (i32.const 3)) (local.get $n)))
        (local.set $ktok (mem.read_ref_ro (local.get $tbuf) (local.get $i)))
        (local.set $vtok (mem.read_ref_ro (local.get $tbuf) (i32.add (local.get $i) (i32.const 2))))
        (local.set $e (mem.alloc (i32.const 4) (i32.const 1)))
        (mem.write_i32 (local.get $e) (i32.const 0) (call $parse_u32 (mem.read_ref_ro (local.get $vtok) (i32.const 0))))
        (mem.write_ref (local.get $e) (i32.const 0) (mem.read_ref_ro (local.get $ktok) (i32.const 0)))
        (call $Vec_Kv__push (local.get $entries) (local.get $e))
        (local.set $i (i32.add (local.get $i) (i32.const 4)))
        (br $lp)))
    (local.get $entries))
)
