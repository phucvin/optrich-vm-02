// Example 01 — Optic Basics: functions, recursion, loops, casts, and step tracing

import host::trace_i32;
import host::trace_i64;
import host::trace_f64;

fn fib(n: i32) -> i32 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn sum_range(n: i32) -> i32 {
    let mut acc = 0;
    for i in 1..(n + 1) {
        acc += i;
    }
    return acc;
}

fn collatz_steps(start: i32) -> i32 {
    let mut n = start;
    let mut steps = 0;
    while n != 1 {
        if (n % 2) == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        steps += 1;
    }
    return steps;
}

fn square_i64(x: i32) -> i64 {
    let big = x as i64;
    return big * big;
}

export fn main() -> i32 {
    let f10 = fib(10);
    trace_i32("step1.fib10", f10);

    let s100 = sum_range(100);
    trace_i32("step2.sum100", s100);

    let c27 = collatz_steps(27);
    trace_i32("step3.collatz27", c27);

    let sq = square_i64(1000000);
    trace_i64("step4.big_square", sq);

    let avg = (s100 as f64) / 100.0;
    trace_f64("step5.avg", avg);

    return f10 + s100 + c27;
}
