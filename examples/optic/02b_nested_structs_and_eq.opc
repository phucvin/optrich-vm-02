// Example 02b — Nested Structs, `[]MyStruct` Ref-Slices, and Identity (`===`) vs Value Equality

import host::trace_i32;
import host::trace_meta;

struct Point {
    x: i32, // bytes[0..4)
    y: i32, // bytes[4..8)
}

impl Point {
    fn new(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }

    fn equals(self: ro Point, other: ro Point) -> bool {
        return self.x == other.x && self.y == other.y;
    }
}

struct Rect {
    w: i32,        // bytes[0..4)
    h: i32,        // bytes[4..8)
    origin: Point, // refs[0]
}

impl Rect {
    fn area(self: ro Rect) -> i32 {
        return self.w * self.h;
    }
}

fn sum_x(pts: ro []Point) -> i32 {
    let mut acc = 0;
    for i in 0..pts.len {
        acc += pts[i].x;
    }
    return acc;
}

export fn main() -> i32 {
    let p1 = Point::new(10, 20);
    let p2 = Point::new(10, 20);
    let p1_alias = p1;

    // Handle identity (mem.eq) vs structural equality
    trace_i32("step1.same_id", (p1 === p1_alias) as i32);
    trace_i32("step2.diff_id", (p1 === p2) as i32);
    trace_i32("step3.val_eq", p1.equals(readonly(p2)) as i32);

    // Nested struct
    let r = Rect { w: 5, h: 4, origin: p1 };
    trace_meta("step4.rect_meta", r);
    trace_i32("step5.rect_origin_x", r.origin.x);
    trace_i32("step6.rect_area", r.area());

    // Reference slice of structs (`[]Point`) + zero-copy sub-slice (`mem.ref_span`)
    let pts = new [Point; 3];
    pts[0] = Point::new(1, 0);
    pts[1] = Point::new(10, 0);
    pts[2] = Point::new(100, 0);

    let tail: ro []Point = readonly(pts[1..3]);
    trace_meta("step7.tail_meta", tail);
    let sx = sum_x(tail);
    trace_i32("step8.tail_sum_x", sx);

    return sx + r.area();
}
